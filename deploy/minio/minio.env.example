# Copy to /opt/minio/minio.env on <training-host> (NOT into this repo -- same
# .env/.env.example split this project already uses everywhere else).
# chmod 600, owned by the minio user -- this file holds the actual root
# credentials.

# Generate real values on <training-host> itself, e.g.:
#   openssl rand -base64 24
# (run twice -- once for the user, once for the password -- don't reuse
# one value for both).
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_AT_LEAST_8_CHARS

MINIO_VOLUME=/opt/minio/data

# Tailscale-only bind, matching this project's stated architecture
# ("Связность -- Tailscale, приватная сеть без публичных портов на
# <inference-host>/<training-host>/Desktop", README). Confirm this machine's actual address with
# `tailscale ip -4` -- the value below is Pinance_ML/.env.example's
# existing placeholder for <training-host>, replace if it's stale.
# Port 9000 = S3 API (what model_storage.py / predictor-ml-inference talk
# to). Port 9001 = web console (optional, for eyeballing buckets by hand).
MINIO_BIND_ADDRESS=<training-host-ip>:9000
MINIO_CONSOLE_ADDRESS=<training-host-ip>:9001
