# Copy to /opt/mlflow/mlflow.env on <training-host> (NOT into this repo -- same
# .env/.env.example split this project uses everywhere else). chmod 600,
# owned by the `pinance` service user: this file holds the Postgres DSN
# and a MinIO key.

# --- Backend store (metadata: runs, params, metrics, tags) ---
# A dedicated `mlflow` database on the SAME Postgres predictor-backend
# uses (<backend-host>, reached over Tailscale) -- already backed up there, and
# MLflow's schema is a handful of small tables. Create it once, with its
# own role:
#   psql -h <db-host-ip> -U postgres -c "CREATE ROLE mlflow LOGIN PASSWORD 'CHANGE_ME';"
#   psql -h <db-host-ip> -U postgres -c "CREATE DATABASE mlflow OWNER mlflow;"
# (psycopg2 is already in this repo's venv -- the bare postgresql:// URI
# resolves to it.)
MLFLOW_BACKEND_STORE_URI=postgresql://mlflow:CHANGE_ME@<db-host-ip>:5432/mlflow

# --- Artifact store (files: eval_metrics.json, per-horizon CSVs, feature
# importance, and every reports/* file a measure_*/screen_* run wrote) ---
# A NEW MinIO bucket on <training-host>, separate from `pinance-models` (which
# predictor-ml-inference on <inference-host> polls every 10 min) -- different bucket,
# its own scoped access key, so a tracking-store credential leak can't
# touch served models. Create both before first start, e.g.:
#   mc mb local/pinance-mlflow
#   mc admin user add local mlflow-artifacts CHANGE_ME_SECRET
#   mc admin policy attach local readwrite --user mlflow-artifacts   # or a bucket-scoped policy
MLFLOW_ARTIFACTS_DESTINATION=s3://pinance-mlflow
MLFLOW_S3_ENDPOINT_URL=http://<training-host-ip>:9000
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# --- Bind address ---
# The Tailscale interface, matching deploy/minio (MinIO binds its own
# tailnet IP here, not 127.0.0.1) -- <backend-host> needs to reach this for tab 03's
# "Open MLflow UI" link, and the desktop training box needs it to log
# runs. Confirm this machine's address with `tailscale ip -4`; <training-host-ip>
# is Pinance_ML/.env.example's existing <training-host> placeholder.
MLFLOW_BIND_ADDRESS=<training-host-ip>
MLFLOW_PORT=5000

# --- Host-header allowlist (MLflow >= 3.x DNS-rebinding protection) ---
# MLflow's server-side Host validation defaults to localhost + RFC1918
# private ranges (192.168.*, 10.*, 172.16-31.*). Tailscale addresses are
# CGNAT <TAILSCALE_IP>/10 -- NOT in that list -- so every API call arriving at
# http://<training-host-ip>:5000 gets 403 "possible DNS rebinding attack"
# (/health is exempt, which makes the service look healthy while every
# client fails). Setting this REPLACES the defaults, so localhost must be
# re-listed explicitly. Entries are exact matches unless they contain '*'.
MLFLOW_SERVER_ALLOWED_HOSTS=<training-host-ip>:5000,<training-host-ip>,localhost:*,localhost,127.0.0.1:*,127.0.0.1,mlflow.example.com

# --- CORS origin allowlist (separate from the Host allowlist above) ---
# The UI's POST requests (create experiment, runs/search, logged-models/
# search, ui-telemetry) carry an `Origin:` header equal to whatever URL the
# browser is on. MLflow rejects any state-changing request whose Origin is
# not localhost or listed here with 403 "Cross-origin request blocked" --
# the experiment list then fails with "Request error / INTERNAL_ERROR" and
# "Create experiment" fails outright, while plain GETs (no Origin) still
# work, so the server looks healthy. List every URL the UI is opened from,
# scheme included, exact match (no trailing slash, no path).
MLFLOW_SERVER_CORS_ALLOWED_ORIGINS=https://mlflow.example.com,http://<training-host-ip>:5000
