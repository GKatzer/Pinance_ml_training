# Read-only connection to TimescaleDB on <backend-host> (reached via Tailscale) --
# co-located with the FastAPI backend, not <training-host> (<training-host> is training + news
# parser only; an earlier README draft had the DB there and was corrected
# 2026-07-21 -- this comment was missed at the time).
DATABASE_URL=postgresql+psycopg2://pinance_ro:CHANGE_ME@<db-host-ip>:5432/pinance

# Write-capable connection for scripts/fetch_news.py (the one writer in
# this repo -- see sql/news_schema.sql). Optional: falls back to
# DATABASE_URL above if unset, for a single-role dev/test setup.
# NEWS_DATABASE_URL=postgresql+psycopg2://pinance_rw:CHANGE_ME@<db-host-ip>:5432/pinance

# scripts/auto_retrain.py's push target (README "Ретрейн регрессора") --
# same MinIO instance already running on <training-host>, predictor-ml-inference
# polls this bucket to pick up new production/candidate models.
# MINIO_ENDPOINT=<training-host-ip>:9000
# MINIO_ACCESS_KEY=CHANGE_ME
# MINIO_SECRET_KEY=CHANGE_ME
# MINIO_SECURE=false
# MINIO_MODELS_BUCKET=pinance-models

# scripts/promote_if_better.py's read-only source for live shadow metrics
# (see deploy/promote_if_better/README.md). Requires predictor-backend's
# `api` container to actually publish its port on the Tailscale interface,
# not just 127.0.0.1 (docker-compose.yml on <backend-host> today binds it to
# loopback only -- this needs to change there before this will connect).
# PREDICTOR_BACKEND_URL=http://<db-host-ip>:8002

# --- Experiment tracking (pinance_ml.tracking -> MLflow on <training-host>) ---
# Unset => pinance_ml.tracking is a silent no-op: scripts/auto_retrain*.py
# and scripts/measure_*/screen_*.py run exactly as before, nothing is
# logged, nothing fails (same contract as PREDICTOR_BACKEND_URL above).
# Set all four to journal runs to the MLflow server (deploy/mlflow/,
# co-located with MinIO on <training-host>). The last three are read by the mlflow
# client itself, not this repo's config -- they point its artifact store
# at the `pinance-mlflow` MinIO bucket (a separate bucket + key from
# `pinance-models`, which predictor-ml-inference on <inference-host> polls -- don't
# reuse that credential here).
# PINANCE_MLFLOW_TRACKING_URI=http://<training-host-ip>:5000
# MLFLOW_S3_ENDPOINT_URL=http://<training-host-ip>:9000
# AWS_ACCESS_KEY_ID=CHANGE_ME
# AWS_SECRET_ACCESS_KEY=CHANGE_ME
